# Local fallback: sqlite. Cloud testing / Vercel: supabase.
BACKEND=sqlite
PORT=3001
DB_PATH=./server/data/portfolio.sqlite
ADMIN_TOKEN=replace-with-a-long-random-secret

# Server-only variables. Never prefix SUPABASE_SECRET_KEY with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# UUID from Authentication > Users. Blank means admin access is disabled.
SUPABASE_ADMIN_USER_ID=

# Server-only image uploads. Never use a VITE_ prefix.
IMGBB_API_KEY=
