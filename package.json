{
  "name": "revan-pixel-world",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/api.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "phaser": "^4.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.9.9",
    "vite": "^8.0.12"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
